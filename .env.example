# ==============================================================================
# 1. CẤU HÌNH HỆ THỐNG & APP GENERAL
# ==============================================================================
PROJECT_NAME="Enterprise Job Matching Platform"
ENVIRONMENT=development
DEBUG=true

# ==============================================================================
# 2. CẤU HÌNH DATABASE (POSTGRESQL + PGVECTOR)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_matching_db

# Chuỗi kết nối SQLAlchemy sử dụng cho Tầng 3 & Tầng 4
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_matching_db

# ==============================================================================
# 3. CẤU HÌNH BẢO MẬT & XÁC THỰC (JWT AUTH)
# ==============================================================================
# Tạo mã Secret Key bằng lệnh: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# 4. CẤU HÌNH HÀNG ĐỢI TIN NHẮN (RABBITMQ BROKER)
# ==============================================================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Chuỗi kết nối Pika / Celery amqp URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Tên các Queue điều phối Task Async giữa Tầng 3, 4 và 5
CV_QUEUE_NAME=cv_processing_queue
JD_QUEUE_NAME=jd_ingestion_queue

# ==============================================================================
# 5. CẤU HÌNH LƯU TRỮ ĐỐI TƯỢNG (MINIO OBJECT STORAGE)
# ==============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CV=user-cvs

# ==============================================================================
# 6. CẤU HÌNH TẦNG AI PROCESSING (TẦNG 4 - WORKER)
# ==============================================================================
# API Key của Google Gemini dùng để bóc tách NER, Graph dữ liệu CV/JD
GEMINI_API_KEY=AIzaSyYourActualGeminiKeyGoesHere_xxxxxxxx

# Kích thước Vector của Model nhúng (Đang dùng 768 theo cấu hình Model của bạn)
VECTOR_DIMENSION=768

# ==============================================================================
# 7. CẤU HÌNH BỘ ĐỆM (REDIS CACHE - NẾU CÓ DÙNG CHO JOB SEARCH / CELERY)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
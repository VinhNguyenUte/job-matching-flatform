# Shared infrastructure
POSTGRES_DB=job_matching_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override. Leave empty to use default gemini-embedding-001.
# AI_EMBEDDING_MODEL=gemini-embedding-001

# Vertex AI optional config. Keep AI_PROVIDER=gemini unless you explicitly use Vertex.
VERTEX_API_KEY=your_vertex_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Service discovery
AI_SERVICE_URL=http://ai-service:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
